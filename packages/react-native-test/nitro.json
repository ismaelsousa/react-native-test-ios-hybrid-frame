{
  "$schema": "https://nitro.margelo.com/nitro.schema.json",
  "cxxNamespace": [
    "test"
  ],
  "ios": {
    "iosModuleName": "Test"
  },
  "android": {
    "androidNamespace": [
      "test"
    ],
    "androidCxxLibName": "Test"
  },
  "autolinking": {
    "Test": {
      "ios": {
        "language": "swift",
        "implementationClassName": "HybridTest"
      },
      "android": {
        "language": "kotlin",
        "implementationClassName": "HybridTest"
      }
    }
  },
  "ignorePaths": [
    "**/node_modules"
  ]
}